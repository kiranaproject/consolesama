program ftml_embed;

{$mode objfpc}{$H+}

uses
  Classes, SysUtils, resource, reswriter;

type
  TEmbedItem = record
    FormName: string;
    FileName: string;
    Source: RawByteString;
  end;

var
  GItems: array of TEmbedItem;
  GOutFile: string = 'src/main/pascal/consolesama.ftml.res.pas';
  GUnitName: string = 'ConsoleSama.Ftml.Res';

function SanitizeIdent(const S: string): string;
var
  i: Integer;
  c: Char;
begin
  Result := '';
  for i := 1 to Length(S) do
  begin
    c := S[i];
    if (c in ['a'..'z', 'A'..'Z', '0'..'9']) then
      Result := Result + c
    else
      Result := Result + '_';
  end;
  if (Result = '') or (Result[1] in ['0'..'9']) then
    Result := '_' + Result;
end;

function StripExt(const S: string): string;
begin
  Result := ChangeFileExt(ExtractFileName(S), '');
end;

function ExtractFormDirective(const ASource: RawByteString): string;
var
  p, e: Integer;
  line, rest, name: string;
begin
  Result := '';
  p := 1;
  while p <= Length(ASource) do
  begin
    e := p;
    while (e <= Length(ASource)) and (ASource[e] <> #10) do
      Inc(e);
    line := Trim(Copy(string(ASource), p, e - p));
    if Copy(line, 1, 2) = '//' then
    begin
      rest := Trim(Copy(line, 3, MaxInt));
      if (Pos('@form', LowerCase(rest)) = 1) then
      begin
        name := Trim(Copy(rest, 6, MaxInt));
        if name <> '' then
        begin
          Result := name;
          Exit;
        end;
      end;
    end
    else if line <> '' then
      Break;
    p := e + 1;
  end;
end;

procedure AddItem(const AFormName, AFileName: string);
var
  fs: TFileStream;
  item: TEmbedItem;
  src: RawByteString;
  directive: string;
begin
  if not FileExists(AFileName) then
  begin
    WriteLn(StdErr, 'ftml_embed: file not found: ', AFileName);
    Halt(2);
  end;

  fs := TFileStream.Create(AFileName, fmOpenRead or fmShareDenyWrite);
  try
    SetLength(src, fs.Size);
    if fs.Size > 0 then
      fs.ReadBuffer(src[1], fs.Size);
  finally
    fs.Free();
  end;

  directive := ExtractFormDirective(src);
  item.FormName := AFormName;
  if item.FormName = '' then
    item.FormName := directive;
  if item.FormName = '' then
    item.FormName := StripExt(AFileName);
  item.FileName := ExtractFileName(AFileName);
  item.Source := src;

  SetLength(GItems, Length(GItems) + 1);
  GItems[High(GItems)] := item;
end;

function MakeArrayName(const AFormName: string): string;
begin
  Result := 'FTML_DATA_' + SanitizeIdent(AFormName);
end;

procedure EmitUnit(const AFileName, AUnitName: string);
var
  sl: TStringList;
  i, j, col, n: Integer;
  item: TEmbedItem;
  arrName: string;
  b: Byte;
  lineBuf: string;
begin
  sl := TStringList.Create();
  try
    sl.Add('// Generated by ftml_embed. Do not edit by hand.');
    sl.Add('unit ' + AUnitName + ';');
    sl.Add('');
    sl.Add('{$mode objfpc}{$H+}');
    sl.Add('');
    sl.Add('interface');
    sl.Add('');
    sl.Add('procedure RegisterEmbeddedFTMLResources();');
    sl.Add('');
    sl.Add('implementation');
    sl.Add('');
    sl.Add('uses');
    sl.Add('  ftpas.ftml.res;');
    sl.Add('');

    for i := 0 to High(GItems) do
    begin
      item := GItems[i];
      arrName := MakeArrayName(item.FormName);
      sl.Add('const');
      sl.Add('  ' + arrName + ': array[0..' + IntToStr(Length(item.Source) - 1) + '] of Byte = (');

      lineBuf := '    ';
      col := 0;
      for j := 1 to Length(item.Source) do
      begin
        b := Byte(item.Source[j]);
        lineBuf := lineBuf + IntToStr(b);
        Inc(col);
        if j < Length(item.Source) then
          lineBuf := lineBuf + ',';
        if col >= 16 then
        begin
          sl.Add(lineBuf);
          lineBuf := '    ';
          col := 0;
        end
        else if j < Length(item.Source) then
          lineBuf := lineBuf + ' ';
      end;
      if col > 0 then
        sl.Add(lineBuf);
      sl.Add('  );');
      sl.Add('');
    end;

    sl.Add('procedure RegisterEmbeddedFTMLResources();');
    sl.Add('begin');
    for i := 0 to High(GItems) do
    begin
      item := GItems[i];
      arrName := MakeArrayName(item.FormName);
      sl.Add('  RegisterFTMLResource(''' + StringReplace(item.FormName, '''', '''''', [rfReplaceAll]) +
        ''', ''' + StringReplace(item.FileName, '''', '''''', [rfReplaceAll]) +
        ''', PChar(@' + arrName + '[0]), ' + IntToStr(Length(item.Source)) + ');');
    end;
    sl.Add('end;');
    sl.Add('');
    sl.Add('initialization');
    sl.Add('  RegisterEmbeddedFTMLResources();');
    sl.Add('');
    sl.Add('end.');

    ForceDirectories(ExtractFileDir(ExpandFileName(AFileName)));
    sl.SaveToFile(AFileName);
    n := Length(GItems);
    if n = 1 then
      WriteLn('ftml_embed: wrote ', AFileName, ' (1 document)')
    else
      WriteLn('ftml_embed: wrote ', AFileName, ' (', n, ' documents)');
  finally
    sl.Free();
  end;
end;

procedure EmitRes(const AFileName: string);
var
  res: TResources;
  raw: TGenericResource;
  descType, descName: TResourceDesc;
  i, n: Integer;
  item: TEmbedItem;
  formNameUpper: string;
begin
  res := TResources.Create();
  try
    for i := 0 to High(GItems) do
    begin
      item := GItems[i];
      formNameUpper := UpperCase(item.FormName);
      descType := TResourceDesc.Create(10); // RT_RCDATA = 10
      descName := TResourceDesc.Create(formNameUpper);
      raw := TGenericResource.Create(descType, descName);
      descType.Free();
      descName.Free();
      if Length(item.Source) > 0 then
        raw.RawData.WriteBuffer(item.Source[1], Length(item.Source));
      res.Add(raw);
    end;
    ForceDirectories(ExtractFileDir(ExpandFileName(AFileName)));
    res.WriteToFile(AFileName);
    n := Length(GItems);
    if n = 1 then
      WriteLn('ftml_embed: wrote resource file ', AFileName, ' (1 document)')
    else
      WriteLn('ftml_embed: wrote resource file ', AFileName, ' (', n, ' documents)');
  finally
    res.Free();
  end;
end;

function BaseNameNoExt(const APath: string): string;
begin
  Result := ChangeFileExt(ExtractFileName(APath), '');
end;

var
  i: Integer;
  arg, outArg, unitArg, formArg, fileArg: string;
  eqAt: Integer;
  isRes: Boolean;
begin
  outArg := '';
  unitArg := '';
  isRes := False;

  i := 1;
  while i <= ParamCount() do
  begin
    arg := ParamStr(i);
    if (arg = '--out') or (arg = '-o') then
    begin
      Inc(i);
      outArg := ParamStr(i);
    end
    else if (arg = '--res') or (arg = '-r') then
    begin
      Inc(i);
      outArg := ParamStr(i);
      isRes := True;
    end
    else if arg = '--unit' then
    begin
      Inc(i);
      unitArg := ParamStr(i);
    end
    else if arg = '--form' then
    begin
      Inc(i);
      formArg := ParamStr(i);
      eqAt := Pos('=', formArg);
      if eqAt > 0 then
        AddItem(Copy(formArg, 1, eqAt - 1), Copy(formArg, eqAt + 1, MaxInt))
      else
        AddItem('', formArg);
    end
    else if (Copy(arg, 1, 1) <> '-') then
    begin
      fileArg := arg;
      eqAt := Pos('=', fileArg);
      if (eqAt > 0) and (not FileExists(fileArg)) then
        AddItem(Copy(fileArg, 1, eqAt - 1), Copy(fileArg, eqAt + 1, MaxInt))
      else
        AddItem('', fileArg);
    end
    else
    begin
      WriteLn(StdErr, 'ftml_embed: unknown option ', arg);
      Halt(2);
    end;
    Inc(i);
  end;

  if Length(GItems) = 0 then
  begin
    WriteLn(StdErr, 'Usage: ftml_embed [--res <file.res>] [--out <file.pas>] [--unit <UnitName>] [--form Name=file.ftml] file.ftml [...]');
    Halt(2);
  end;

  if (outArg <> '') and (LowerCase(ExtractFileExt(outArg)) = '.res') then
    isRes := True;

  if isRes then
  begin
    if outArg = '' then
      outArg := 'consolesama.res';
    EmitRes(outArg);
  end
  else
  begin
    if outArg = '' then
      outArg := GOutFile;
    if unitArg = '' then
      unitArg := GUnitName;
    EmitUnit(outArg, unitArg);
  end;
end.
